{
  "name": "mimo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chat agent with one tool (web search) whose answers about time come from code.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run.ts",
    "demo:seed": "tsx eval/seed.ts",
    "brief": "tsx eval/brief.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@langchain/core": "1.3.7",
    "@langchain/langgraph": "1.7.3",
    "chrono-node": "2.10.3",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
