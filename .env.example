# History database (Postgres). `npm run db:up` starts one with these credentials.
MIMO_DATABASE_URL=postgres://mimo:mimo@localhost:5433/mimo

# Model: Anthropic (Claude)
ANTHROPIC_API_KEY=

# Search: Tavily is the default provider; Brave is used if only its key is set
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional: model per tier. time = reading date phrases (default claude-haiku-5-5, effort low);
# fast = router/extraction, main = writer, recheck = deep (default claude-opus-5-5, effort low / medium / high).
MODEL_TIME=
MODEL_FAST=
MODEL_MAIN=
MODEL_DEEP=

# Fallback time zone when the browser sends none (IANA name)
AGENT_TZ=UTC

PORT=3000

# Optional: LangSmith tracing of graph nodes
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
