# History database (Postgres). `npm run db:up` starts one with these credentials.
MIMO_DATABASE_URL=postgres://mimo:mimo@localhost:5433/mimo

# Model provider: groq (default) or anthropic
MODEL_PROVIDER=groq
GROQ_API_KEY=
# Optional: several Groq keys, comma-separated; requests rotate and skip rate-limited keys
GROQ_API_KEYS=
# Groq on_demand tier allows ~8000 tokens/minute; requests are trimmed to fit this input budget
GROQ_MAX_INPUT_TOKENS=5000
ANTHROPIC_API_KEY=

# Search: Tavily is the default provider; Brave is used if only its key is set
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional: model per tier (router/extraction = fast, writer = main, recheck = deep).
# Groq defaults: openai/gpt-oss-20b (fast), openai/gpt-oss-120b (main, deep).
# Anthropic default: claude-opus-5-5 for all three.
MODEL_FAST=
MODEL_MAIN=
MODEL_DEEP=

# Fallback time zone when the browser sends none (IANA name)
AGENT_TZ=UTC

PORT=3000

# Optional: LangSmith tracing of graph nodes
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
